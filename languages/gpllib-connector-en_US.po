#. translators: %d: 建议等待的秒数。
#: includes/ErrorMap.php:156
#, php-format
msgid "请求过于频繁，请约 %d 秒后再试。"
msgstr "Too many requests. Please try again in about %d seconds."

#: includes/ErrorMap.php:173
msgid "GPLlib 服务暂时不可用（未返回可识别的数据），请稍后再试。"
msgstr "GPLlib is temporarily unavailable and did not return any recognisable data. Please try again later."

#. translators: %s: 资源 slug（目录名）。
#: includes/Updater.php:230
#, php-format
msgid "更新包校验未通过：%s 的文件与 GPLlib 记录的不一致，可能是下载损坏或文件被篡改。已删除该临时文件，本次更新已中止，请稍后重试。"
msgstr "Update package verification failed: the file for %s does not match the checksum recorded by GPLlib, so the download may be corrupted or the file may have been tampered with. The temporary file has been deleted and this update was aborted. Please try again later."

#: includes/ErrorMap.php:176
msgid "该地址没有返回 GPLlib 的数据，请核对设置页「设置 → API 地址」是否填写正确。"
msgstr "That address did not return GPLlib data. Open the Settings tab and check that the API address is correct."

