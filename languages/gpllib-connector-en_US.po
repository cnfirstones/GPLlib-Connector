#. Plugin Name of the plugin
#: gpllib-connector.php
#: includes/Settings.php:26
msgid "GPLlib Connector"
msgstr "GPLlib Connector"

#. Plugin URI of the plugin
#: gpllib-connector.php
msgid "https://gpllib.com/connector"
msgstr "https://gpllib.com/connector"

#. Description of the plugin
#: gpllib-connector.php
msgid "将本站与 GPLlib 账户绑定，对「已购买 / 会员有效期内」且 GPLlib 标注支持自动更新的主题/插件实现自动更新。"
msgstr "Bind this site to your GPLlib account and keep the themes and plugins you are entitled to — bought outright, or covered by an active membership — up to date automatically, whenever GPLlib marks them as supporting automatic updates."

#. Author of the plugin
#: gpllib-connector.php
msgid "GPL Library Team"
msgstr "GPL Library Team"

#. Author URI of the plugin
#: gpllib-connector.php
msgid "https://gpllib.com"
msgstr "https://gpllib.com"

#: includes/Client.php:77
#: includes/Settings.php:209
msgid "激活失败"
msgstr "Activation failed"

#: includes/Client.php:90
msgid "本地已解绑（主站通知失败）"
msgstr "Unbound locally (GPLlib could not be notified)"

#: includes/Client.php:109
msgid "检查更新失败"
msgstr "Could not check for updates"

#: includes/Client.php:141
msgid "无法获取下载地址"
msgstr "Could not obtain a download address"

#: includes/Client.php:162
msgid "无法获取绑定状态"
msgstr "Could not retrieve the binding status"

#: includes/Client.php:191
msgid "尚未绑定，请先激活"
msgstr "This site is not bound yet. Activate it first."

#: includes/ErrorMap.php:101
msgid "当前授权无权执行该操作。"
msgstr "This license is not allowed to perform that operation."

#: includes/ErrorMap.php:103
msgid "该资源已在 GPLlib 下架，暂不提供更新。"
msgstr "This item has been removed from GPLlib and no longer receives updates."

#: includes/ErrorMap.php:105
msgid "今日自动更新次数已用完，明天恢复。"
msgstr "You have used up today's automatic updates. They become available again tomorrow."

#: includes/ErrorMap.php:107
msgid "会员已过期，续费后可继续自动更新。"
msgstr "Your membership has expired. Renew it to resume automatic updates."

#: includes/ErrorMap.php:109
msgid "你的 GPLlib 账户没有该资源的购买记录。"
msgstr "Your GPLlib account has no purchase record for this item."

#: includes/ErrorMap.php:111
msgid "安全校验未通过，请稍后重试。"
msgstr "The security check did not pass. Please try again in a moment."

#: includes/ErrorMap.php:113
#: includes/ErrorMap.php:158
msgid "请求过于频繁，请稍后再试。"
msgstr "Too many requests. Please try again later."

#: includes/ErrorMap.php:115
msgid "授权码无效或绑定失败，请在 GPLlib 用户中心核对后重新激活。"
msgstr "The license key is invalid or the binding failed. Check it in your GPLlib account, then activate again."

#: includes/ErrorMap.php:117
msgid "授权站点数已达上限，请在 GPLlib 用户中心解绑其它站点后重试。"
msgstr "You have reached the limit of licensed sites. Release another site in your GPLlib account, then try again."

#: includes/ErrorMap.php:119
msgid "GPLlib 服务正在维护，暂时只读，请稍后再试。"
msgstr "GPLlib is under maintenance and temporarily read-only. Please try again later."

#: includes/ErrorMap.php:129
msgid "本站令牌已失效或被吊销，请重新激活本站。"
msgstr "This site's token is no longer valid or has been revoked. Please activate this site again."

#: includes/ErrorMap.php:132
msgid "GPLlib 拒绝了本次请求，请在 GPLlib 用户中心确认本站权限。"
msgstr "GPLlib rejected the request. Check this site's permissions in your GPLlib account."

#: includes/ErrorMap.php:138
msgid "GPLlib 服务暂时不可用，请稍后再试。"
msgstr "GPLlib is temporarily unavailable. Please try again later."

#. translators: %d: HTTP 状态码。
#: includes/ErrorMap.php:141
#, php-format
msgid "服务端响应异常（HTTP %d）"
msgstr "Unexpected response from GPLlib (HTTP %d)"

#: includes/ErrorMap.php:187
msgid "无法连接 GPLlib，请检查本站的网络或防火墙设置。"
msgstr "Could not reach GPLlib. Check this site's network or firewall settings."

#: includes/Rest.php:65
#: includes/Settings.php:207
msgid "请输入授权码"
msgstr "Enter your license key"

